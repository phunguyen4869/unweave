# Copy to .env and adjust. Read by docker-compose.yml.

# Hostnames/IPs the UI may be opened with, comma-separated: the LXC's IP, its DNS
# name, a reverse-proxy domain. "name" matches any port, "name:port" just that one.
# "*" accepts any host, which also turns off DNS-rebinding protection; the app has
# no login, so only use it on a network you trust.
UNWEAVE_ALLOWED_HOSTS=192.168.1.50,unweave.lan

# Port on the Docker host.
UNWEAVE_PORT=8765

# Where data lives on the Docker host. Must be writable by UID/GID 1000.
UNWEAVE_CONFIG_DIR=./data/config
UNWEAVE_MODELS_DIR=./data/models
UNWEAVE_PROJECTS_DIR=./data/projects

# Inference threads (default: CPU count - 1). Docker sees the host's cores, not the
# LXC's limit, so set this to the LXC's core count if it has a cap.
UNWEAVE_THREADS=

# Separation jobs run at once. Keep 1 unless the LXC has plenty of RAM.
UNWEAVE_MAX_CONCURRENT_JOBS=1

TZ=Asia/Ho_Chi_Minh

# CUDA build of PyTorch instead of CPU (needs an NVIDIA GPU passed into the LXC and
# the NVIDIA Container Toolkit), e.g. https://download.pytorch.org/whl/cu124
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
